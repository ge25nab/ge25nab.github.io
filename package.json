    "clsx": "^2.1.0",
    "date-fns": "^3.2.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.344.0",
    "next": "^16.3.8",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
